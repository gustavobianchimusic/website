---
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Biography of pianist and educator Dr. Gustavo Bianchi."
    />
    <title>Biography | Dr. Gustavo Bianchi</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">Gustavo Bianchi</a>

      <nav aria-label="Main navigation">
        <a href="/#about">About</a>
        <a href="/#music">Music</a>
        <a href="/studio">Studio</a>
        <a href="/accompanist">Accompanist</a>
        <a href="#contact">Contact</a>
      </nav>
      <details class="mobile-navigation">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="/#about">About</a>
          <a href="/#music">Music</a>
          <a href="/studio">Studio</a>
          <a href="/accompanist">Accompanist</a>
          <a href="#contact">Contact</a>
        </nav>
      </details>
    </header>

    <main>
      <article class="biography">
        <p class="eyebrow">Biography</p>
        <h1>Gustavo Bianchi</h1>

        <div class="biography-copy">
          <p>
            Dr. Gustavo Bianchi is a pianist, educator, and collaborative
            artist whose career has included performances throughout the
            United States, South America, and Asia. Rooted in the classical
            tradition, his work spans solo and chamber music, collaboration,
            teaching, and original piano interpretations of contemporary
            music, Mandopop, and film repertoire.
          </p>

          <p>
            He holds a Doctor of Musical Arts in Piano Performance from The
            University of Texas at Austin, where he studied with Anton Nel, as
            well as Master of Music and Bachelor of Music degrees in Piano
            Performance from Florida State University. His early musical
            training included the pre-college program at the New England
            Conservatory and study at the Longy School of Music. His first
            piano teacher, Nadia Soledade, was a student of Alfred Cortot,
            connecting his musical background to a teaching tradition reaching
            back to Frédéric Chopin.
          </p>

          <p>
            As a performer, Dr. Bianchi has received prizes at the Sidney
            Wright Piano Accompanying Competition, the Bartók and Kabalevsky
            International Piano Competition, and the Young Chang Artist
            Competition. His musical development has also included coaching
            and study with artists and pedagogues including Menahem Pressler,
            Randall Hodgkinson, Sergei Schepkin, and Leonard Mastrogiacomo.
          </p>

          <p>
            Dr. Bianchi has taught privately for more than two decades and
            currently serves on the piano faculty at the New Heart Christian
            School of Music in the Houston area while maintaining his
            independent studio in Pearland, Texas. He received the Austin
            District Music Teachers Association Outstanding Pre-College
            Teaching Achievement Award in 2012, and former students have
            continued their studies at institutions including the Eastman
            School of Music, Mannes School of Music, the University of North
            Texas College of Music, and the University of Southern California.
          </p>

          <p>
            Collaboration has remained an important part of his professional
            life. After completing his doctorate at The University of Texas at
            Austin, he continued at the Butler School of Music as an Adjunct
            Faculty Collaborative Pianist. His collaborative work has also
            included Austin Opera, NATS competitions, the Texas State
            Solo-Ensemble Contest, and performances with instrumentalists and
            vocalists across a wide range of repertoire.
          </p>

          <p>
            At Bianchi Piano Studio, his teaching is grounded in the belief
            that technique and musicianship should ultimately serve
            expression. Lessons are shaped around the individual student, with
            the goal of developing thoughtful, independent musicians who learn
            not simply to play the piano, but to communicate through it.
          </p>
        </div>
      </article>
    </main>

    <SiteFooter id="contact" />

    <script>
      document.querySelectorAll(".mobile-navigation").forEach((menu) => {
        menu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => menu.removeAttribute("open"));
        });
      });
    </script>

    <style is:global>
      :root {
        --background: #0d0c0b;
        --background-soft: #151310;
        --panel: #1c1813;
        --cream: #f2eadc;
        --cream-muted: #c9bead;
        --gold: #c6a15b;
        --gold-light: #dfc485;
        --border: rgba(223, 196, 133, 0.22);
        --serif: "Cormorant Garamond", serif;
        --sans: "Inter", sans-serif;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--background);
        color: var(--cream);
        font-family: var(--sans);
        font-weight: 300;
        line-height: 1.8;
      }

      a { color: inherit; text-decoration: none; }

      .site-header {
        position: absolute;
        z-index: 10;
        top: 0;
        left: 0;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 26px clamp(24px, 5vw, 80px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }

      .brand {
        font-family: var(--serif);
        font-size: 1.65rem;
        font-weight: 500;
        letter-spacing: 0.04em;
      }

      .site-header > nav { display: flex; gap: clamp(16px, 2.2vw, 30px); }

      .site-header nav a {
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.74rem;
        font-weight: 400;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .site-header nav a:hover { color: var(--gold-light); }

      .mobile-navigation { display: none; }

      .mobile-navigation summary {
        list-style: none;
        cursor: pointer;
        color: var(--gold-light);
        font-size: 0.76rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .mobile-navigation summary::-webkit-details-marker { display: none; }

      .mobile-navigation nav {
        position: absolute;
        top: 80px;
        right: 24px;
        display: grid;
        gap: 18px;
        min-width: 210px;
        padding: 24px;
        border: 1px solid var(--border);
        background: var(--background-soft);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
      }

      .biography {
        width: min(880px, calc(100% - 48px));
        margin: 0 auto;
        padding: clamp(150px, 17vw, 220px) 0 clamp(90px, 10vw, 140px);
      }

      .eyebrow {
        margin: 0 0 18px;
        color: var(--gold-light);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0 0 clamp(52px, 7vw, 78px);
        font-family: var(--serif);
        font-size: clamp(4rem, 8vw, 7rem);
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 0.98;
      }

      .biography-copy {
        max-width: 760px;
        color: var(--cream-muted);
        font-size: clamp(1rem, 1.3vw, 1.12rem);
      }

      .biography-copy p { margin: 0 0 30px; }

      @media (max-width: 760px) {
        .site-header > nav { display: none; }
        .mobile-navigation { display: block; }
      }

      @media (max-width: 520px) {
        .biography { width: min(100% - 44px, 880px); }
        h1 { font-size: 3.5rem; }
      }
    </style>
  </body>
</html>
