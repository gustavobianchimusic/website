---
import SiteFooter from "../components/SiteFooter.astro";

const collections = [
  {
    title: "Mandopop",
    description:
      "Piano interpretations of beloved songs by artists including JJ Lin, Stefanie Sun, Jay Chou, and others.",
    className: "mandopop",
    alignment: "content-left",
    collectionUrl: "https://www.youtube.com/playlist?list=PLPz1xnho7Bzc",
    performance: {
      title: "Still Wandering",
      artist: "Jay Chou",
      videoUrl: "https://youtu.be/dgEvrfYJXfY",
    },
  },
  {
    title: "Contemporary Piano",
    description:
      "Lyrical and expressive works by contemporary composers from around the world.",
    className: "modern",
    alignment: "content-right",
    collectionUrl: "https://www.youtube.com/playlist?list=PLBFW5bl5saJk",
    performance: {
      title: "River Flows in You",
      artist: "Yiruma",
      videoUrl: "https://youtu.be/m2fyE1h3Llg",
    },
  },
  {
    title: "Film & Animation",
    description:
      "Memorable themes from cinema and animation, reimagined through the voice of the piano.",
    className: "film",
    alignment: "content-left",
    collectionUrl: "https://www.youtube.com/playlist?list=PLP5yXcmTtC1A",
    performance: {
      title: "Comptine d’un autre été: L’après-midi",
      artist: "Yann Tiersen",
      videoUrl: "https://youtu.be/MdVn4rcDgXQ",
    },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Gustavo Bianchi reimagines beloved contemporary melodies and timeless stories through the lens of classical piano."
    />

    <title>Gustavo Bianchi | Pianist and Educator</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">Gustavo Bianchi</a>

      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#music">Music</a>
        <a href="/studio">Studio</a>
        <a href="/accompanist">Accompanist</a>
        <a href="#contact">Contact</a>
      </nav>
      <details class="mobile-navigation">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="#about">About</a>
          <a href="#music">Music</a>
          <a href="/studio">Studio</a>
          <a href="/accompanist">Accompanist</a>
          <a href="#contact">Contact</a>
        </nav>
      </details>
    </header>

    <main>
      <!-- HERO -->

      <section class="hero">
        <div class="hero-overlay"></div>

        <div class="hero-content">
          <p class="eyebrow">Pianist · Educator</p>

          <h1>
            Bringing classical artistry to beloved contemporary melodies.
          </h1>

          <div class="hero-actions">
            <a class="button button-primary" href="#music">
              Explore the Music
            </a>

            <a class="button button-secondary" href="#studio">
              Bianchi Piano Studio
            </a>
          </div>
        </div>
      </section>

      <!-- ABOUT -->

 <section class="section about-section" id="about">
  <div class="section-heading">
    <p class="eyebrow">About</p>

    <h2>
      Reimagining beloved contemporary melodies and timeless stories
      through the lens of classical piano.
    </h2>
  </div>

  <div class="about-layout">
    <div class="about-copy">
  <p>
    Music is at its best when it creates connection. Through original
    piano arrangements of Mandopop, film music, and other contemporary
    favorites, I seek to preserve the emotion that first made these
    melodies unforgettable while revealing them in a new light.
  </p>

  <p>
    The piano has a remarkable ability to transform subtle human emotion into
    sound—from quiet intimacy to sweeping cinematic intensity.
  </p>

  <p>
    Whether performing, teaching, or crafting a new arrangement, I hope every
    performance becomes an invitation—to listen more deeply, remember more
    vividly, and discover familiar music in a new light.
  </p>

  <a class="about-bio-link" href="/bio">Read Full Biography</a>
</div>

    <div
      class="about-portrait"
      role="img"
      aria-label="Painterly portrait of Gustavo Bianchi at a grand piano"
    ></div>
  </div>
</section>
      <!-- PROFESSIONAL SERVICES -->

      <section class="section work-section" id="studio">
        <div class="centered-heading">
          <p class="eyebrow">Teaching &amp; Collaboration</p>
          <h2>Work With Gustavo</h2>
        </div>
        <div class="work-grid">
          <article class="work-card">
            <p class="eyebrow">Teaching</p>
            <h3>Bianchi Piano Studio</h3>
            <p>
              Individualized piano study grounded in artistry, musicianship,
              and thoughtful listening. Each lesson is shaped around the
              student’s musical growth.
            </p>
            <a class="text-link" href="/studio">
              Explore the Studio <span aria-hidden="true">→</span>
            </a>
          </article>
          <article class="work-card">
            <p class="eyebrow">Accompaniment</p>
            <h3>Collaborative Piano</h3>
            <p>
              Attentive accompaniment and musical partnership for students,
              singers, instrumentalists, auditions, schools, and performances.
            </p>
            <a class="text-link" href="/accompanist">
              Accompanist Services <span aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </section>

      <!-- EXPLORE THE MUSIC -->

      <section class="section music-section" id="music">
        <div class="centered-heading">
          <p class="eyebrow">Collections</p>

          <h2>Explore the Music</h2>

          <p class="section-introduction">
            Every arrangement begins with a melody that has already lived a
            story. Through the voice of the piano, these performances invite
            listeners to rediscover familiar music in a new light.
          </p>
        </div>

       <div class="collection-list">
  {
    collections.map((collection) => (
      <article
        class={`collection-panel ${collection.className} ${collection.alignment}`}
      >
        <div class="collection-shade"></div>

        <div class="collection-content">
          <h3>{collection.title}</h3>

          <p class="collection-description">{collection.description}</p>

          <div class="featured-performance">
            <p class="featured-label">Featured Performance</p>
            <h4>
              <a
                class="featured-link"
                href={collection.performance.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {collection.performance.title} <span>— {collection.performance.artist}</span>
              </a>
            </h4>
          </div>

          <a
            class="collection-link"
            href={collection.collectionUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Explore ${collection.title} collection`}
          >Explore Collection</a>
        </div>
      </article>
    ))
  }
</div>
</section>

    </main>

    <SiteFooter id="contact" />

    <script>
      document.querySelectorAll(".mobile-navigation").forEach((menu) => {
        menu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => menu.removeAttribute("open"));
        });
      });
    </script>

    <style is:global>
      :root {
        --background: #0d0c0b;
        --background-soft: #151310;
        --panel: #1c1813;
        --cream: #f2eadc;
        --cream-muted: #c9bead;
        --gold: #c6a15b;
        --gold-light: #dfc485;
        --border: rgba(223, 196, 133, 0.22);
        --serif: "Cormorant Garamond", serif;
        --sans: "Inter", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--cream);
        font-family: var(--sans);
        font-weight: 300;
        line-height: 1.7;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .site-header {
        position: absolute;
        z-index: 10;
        top: 0;
        left: 0;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 26px clamp(24px, 5vw, 80px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      }

      .brand,
      .footer-brand {
        font-family: var(--serif);
        font-size: 1.65rem;
        font-weight: 500;
        letter-spacing: 0.04em;
      }

      .site-header > nav {
        display: flex;
        gap: clamp(16px, 2.2vw, 32px);
      }

      .site-header nav a {
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.76rem;
        font-weight: 400;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        transition:
          color 180ms ease,
          transform 180ms ease;
      }

      .site-header nav a:hover {
        color: var(--gold-light);
        transform: translateY(-1px);
      }

      .mobile-navigation { display: none; }

      .mobile-navigation summary {
        list-style: none;
        cursor: pointer;
        color: var(--gold-light);
        font-size: 0.76rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .mobile-navigation summary::-webkit-details-marker { display: none; }

      .mobile-navigation nav {
        position: absolute;
        top: 80px;
        right: 24px;
        display: grid;
        gap: 18px;
        min-width: 210px;
        padding: 24px;
        border: 1px solid var(--border);
        background: #151310;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
      }

      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        background-image: url("/images/hero-optimized.jpg");
        background-size: cover;
        background-position: 55% center;
        overflow: hidden;
      }

      .hero-overlay {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            90deg,
            rgba(7, 6, 5, 0.95) 0%,
            rgba(7, 6, 5, 0.76) 38%,
            rgba(7, 6, 5, 0.2) 72%,
            rgba(7, 6, 5, 0.12) 100%
          ),
          linear-gradient(
            0deg,
            rgba(7, 6, 5, 0.65) 0%,
            transparent 45%
          );
      }

      .hero-content {
        position: relative;
        z-index: 2;
        width: min(720px, 90%);
        margin-left: clamp(24px, 8vw, 130px);
        padding-top: 90px;
      }

      .eyebrow {
        margin: 0 0 20px;
        color: var(--gold-light);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3 {
        margin-top: 0;
        font-family: var(--serif);
        font-weight: 500;
        line-height: 1.05;
      }

      h1 {
        margin-bottom: 34px;
        font-size: clamp(3.2rem, 6.5vw, 6.5rem);
        letter-spacing: -0.035em;
      }

      h2 {
        margin-bottom: 24px;
        font-size: clamp(2.8rem, 5vw, 5rem);
        letter-spacing: -0.025em;
      }

      h3 {
        margin-bottom: 12px;
        font-size: clamp(2rem, 3vw, 3rem);
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .button {
        display: inline-flex;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        padding: 0 24px;
        border: 1px solid var(--gold);
        font-size: 0.76rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition:
          background 180ms ease,
          color 180ms ease,
          transform 180ms ease;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button-primary {
        background: var(--gold);
        color: #14110d;
      }

      .button-primary:hover {
        background: var(--gold-light);
      }

      .button-secondary {
        background: rgba(10, 9, 8, 0.35);
        color: var(--cream);
        backdrop-filter: blur(10px);
      }

      .button-secondary:hover {
        background: rgba(198, 161, 91, 0.15);
      }

      .section {
        padding: clamp(90px, 11vw, 170px) clamp(24px, 7vw, 110px);
      }

  .about-section {
  display: block;
}

      .section-heading h2 {
        max-width: 800px;
      }

      .about-copy {
        padding-top: 0;
        color: var(--cream-muted);
        font-size: 1.1rem;
        line-height: 1.85;
      }

      .about-copy p {
        margin: 0 0 30px;
      }

      .about-bio-link {
        display: inline-block;
        padding-bottom: 3px;
        border-bottom: 1px solid transparent;
        color: var(--cream-muted);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        transition: color 180ms ease, border-color 180ms ease;
      }

      .about-bio-link:hover,
      .about-bio-link:focus-visible {
        color: var(--gold-light);
        border-bottom-color: var(--gold-light);
      }
.about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(340px, 0.7fr);
    gap: clamp(60px, 9vw, 140px);
    align-items: center;
    margin-top: 48px;
}

.about-portrait {
    background-image: url("/images/about-gustavo.jpg");
    background-size: cover;
    background-position: center top;
    border-radius: 10px;
    border: 1px solid rgba(242,234,220,0.08);
    min-height: 600px;
    box-shadow: 0 25px 60px rgba(0,0,0,.35);
}
      .music-section {
        background:
          radial-gradient(
            circle at 50% 0%,
            rgba(198, 161, 91, 0.12),
            transparent 34%
          ),
          var(--background-soft);
      }

      .centered-heading {
        width: min(820px, 100%);
        margin: 0 auto 64px;
        text-align: center;
      }

      .section-introduction {
        max-width: 700px;
        margin: 0 auto;
        color: var(--cream-muted);
        font-size: 1.04rem;
      }

      .collection-list {
  display: grid;
  gap: 8px;
}

.collection-panel {
  position: relative;
  min-height: 425px;
  display: flex;
  align-items: center;
  padding: clamp(34px, 5vw, 72px);
  border: 1px solid var(--border);
  border-radius: 8px;
  background-position: center;
  background-size: cover;
  overflow: hidden;
  transition:
    transform 350ms ease,
    border-color 350ms ease;
}

.collection-panel:hover {
  transform: translateY(-4px);
  border-color: rgba(223, 196, 133, 0.55);
}

.collection-panel.content-left { justify-content: flex-start; }
.collection-panel.content-right { justify-content: flex-end; }

.collection-shade {
  position: absolute;
  inset: 0;
}

.collection-panel.content-left .collection-shade {
  background: linear-gradient(
    90deg,
    rgba(7, 6, 5, 0.88) 0%,
    rgba(7, 6, 5, 0.64) 38%,
    rgba(7, 6, 5, 0.12) 75%
  );
}

.collection-panel.content-right .collection-shade {
  background: linear-gradient(
    270deg,
    rgba(7, 6, 5, 0.88) 0%,
    rgba(7, 6, 5, 0.64) 38%,
    rgba(7, 6, 5, 0.12) 75%
  );
}

.collection-content {
  position: relative;
  z-index: 2;
  width: min(520px, 54%);
}

.collection-content h3 {
  margin-bottom: 14px;
  font-size: clamp(2.4rem, 4vw, 4rem);
}

.collection-description {
  margin: 0 0 28px;
  color: var(--cream-muted);
  font-size: 0.95rem;
}

.featured-performance {
  margin-bottom: 25px;
  padding-top: 20px;
  border-top: 1px solid rgba(223, 196, 133, 0.32);
}

.featured-label {
  margin: 0 0 7px;
  color: var(--gold-light);
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.featured-performance h4 {
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(1.45rem, 2vw, 1.85rem);
  font-weight: 500;
  line-height: 1.2;
}

.featured-performance h4 span { color: var(--cream-muted); }

.featured-link {
  color: var(--cream);
  transition: color 180ms ease;
}

.featured-link:hover,
.featured-link:focus-visible {
  color: var(--gold-light);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.16em;
}

.featured-link:hover span,
.featured-link:focus-visible span { color: var(--gold-light); }

.collection-link {
  display: inline-block;
  padding-bottom: 3px;
  border-bottom: 1px solid transparent;
  color: var(--cream-muted);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: color 180ms ease, border-color 180ms ease;
}

.collection-link:hover,
.collection-link:focus-visible {
  color: var(--gold-light);
  border-bottom-color: var(--gold-light);
}

.mandopop {
  background-image: url("/images/collection-mandopop-optimized.jpg");
}

.film {
  background-image: url("/images/collection-film-optimized.jpg");
}

.modern {
  background-image: url("/images/collection-modern-optimized.jpg");
}

      .text-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--gold-light);
        font-size: 0.74rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .text-link span {
        transition: transform 180ms ease;
      }

      .text-link:hover span {
        transform: translateX(5px);
      }

      .work-section {
        background: var(--background);
      }

      .work-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }

      .work-card {
        display: flex;
        flex-direction: column;
        min-height: 330px;
        padding: clamp(38px, 4.5vw, 70px);
        border: 1px solid var(--border);
        background:
          linear-gradient(
            135deg,
            rgba(198, 161, 91, 0.08),
            transparent 55%
          ),
          var(--panel);
      }

      .work-card h3 {
        font-size: clamp(2.3rem, 3.5vw, 3.7rem);
      }

      .work-card > p:not(.eyebrow) {
        margin: 0 0 30px;
        color: var(--cream-muted);
      }

      .work-card .text-link { margin-top: auto; }

      @media (max-width: 900px) {
        .site-header {
          position: absolute;
          align-items: flex-start;
        }

        .site-header > nav { display: none; }
        .mobile-navigation { display: block; }

        .hero {
          min-height: 820px;
          align-items: flex-end;
          background-position: 62% center;
        }

        .hero-overlay {
          background:
            linear-gradient(
              0deg,
              rgba(7, 6, 5, 0.98) 0%,
              rgba(7, 6, 5, 0.68) 52%,
              rgba(7, 6, 5, 0.15) 100%
            );
        }

        .hero-content {
          width: auto;
          margin: 0;
          padding: 130px 24px 70px;
        }

        .about-layout,
        .work-grid {
          grid-template-columns: 1fr;
        }

        .about-copy {
          padding-top: 0;
        }

        .collection-panel {
          min-height: 410px;
        }

        .collection-content { width: min(520px, 68%); }

      }

      @media (max-width: 520px) {
        h1 {
          font-size: 3.25rem;
        }

        h2 {
          font-size: 2.75rem;
        }

        .hero-actions {
          flex-direction: column;
          align-items: stretch;
        }

        .button {
          width: 100%;
        }

        .section {
          padding-left: 22px;
          padding-right: 22px;
        }

        .work-card {
          padding: 34px 25px;
          min-height: 0;
        }

        .collection-panel {
          min-height: 440px;
          padding: 34px 25px;
        }

        .collection-panel.content-left .collection-shade,
        .collection-panel.content-right .collection-shade {
          background: linear-gradient(
            90deg,
            rgba(7, 6, 5, 0.86),
            rgba(7, 6, 5, 0.62)
          );
        }

        .collection-content { width: 100%; }
      }
    </style>
  </body>
</html>
